rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shifts actifs du timer (lecture/écriture par l'utilisateur connecté)
    match /activeShifts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Toutes les autres collections : utilisateur connecté
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
